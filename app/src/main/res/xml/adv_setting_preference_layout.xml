<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="@string/preferenceScreen">

    <PreferenceCategory
        android:key="prefCat_advFiltering"
        android:title="@string/prefCat_advFiltering">
        <MultiSelectListPreference
            android:defaultValue="@array/pref_aspectRatioDefault_entryValues_v2"
            android:entries="@array/pref_aspectRatio_entries"
            android:entryValues="@array/pref_aspectRatio_entryValues"
            android:key="pref_aspectRatioSelect_v2"
            android:persistent="true"
            android:title="@string/prefTitle_aspectRatio"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:dialogTitle="@string/prefDialog_atleast"
            android:inputType="text"
            android:key="pref_atleast"
            android:persistent="true"
            android:title="@string/prefTitle_atleast"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="1M"
            android:entries="@array/pref_topRange_entries"
            android:entryValues="@array/pref_topRange_entryValues"
            android:key="pref_topRange"
            android:persistent="true"
            android:title="@string/prefTitle_topRange"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="desc"
            android:entries="@array/pref_order_entries"
            android:entryValues="@array/pref_order_entryValues"
            android:key="pref_order"
            android:persistent="true"
            android:title="@string/prefTitle_order"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:dialogTitle="@string/prefDialog_seed"
            android:inputType="text"
            android:key="pref_seed"
            android:persistent="true"
            android:title="@string/prefTitle_seed"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:dialogTitle="@string/prefDialog_colors"
            android:inputType="text"
            android:key="pref_colors"
            android:persistent="true"
            android:title="@string/prefTitle_colors"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:defaultValue="0"
            android:key="prefSlider_minimumWidth"
            android:max="400"
            android:persistent="true"
            android:title="@string/prefTitle_minimumWidth" />
        <SeekBarPreference
            android:defaultValue="0"
            android:key="prefSlider_minimumHeight"
            android:max="400"
            android:persistent="true"
            android:title="@string/prefTitle_minimumHeight" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="prefCat_fileOptions"
        android:title="@string/prefCat_fileOptions">
        <SwitchPreference
            android:key="pref_autoClearMode"
            android:persistent="true"
            android:title="@string/prefTitle_autoClearMode" />
        <SwitchPreference
            android:key="pref_storeInExtStorage"
            android:persistent="true"
            android:summary="@string/prefSummary_storeInExtStorage"
            android:title="@string/prefTitle_storeInExtStorage" />
        <DropDownPreference
            android:defaultValue="phone"
            android:entries="@array/array_selectWhichStorage_entries"
            android:entryValues="@array/array_selectWhichStorage_entryValues"
            android:key="pref_selectWhichExtStorage"
            android:persistent="true"
            android:title="@string/prefTitle_storingInWhichExtStorage"
            app:isPreferenceVisible="false"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:defaultValue="3"
            android:key="prefSlider_numToDownload"
            android:max="10"
            android:persistent="true"
            android:title="@string/prefTitle_numToDownload"
            app:min="1" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="prefCat_appSettings"
        android:title="@string/prefCat_appSettings">
        <ListPreference
            android:defaultValue="-1"
            android:entries="@array/dark_mode_entries"
            android:entryValues="@array/dark_mode_values"
            android:key="pref_nightMode"
            android:persistent="true"
            android:title="@string/prefTitle_nightModePreference"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            android:key="pref_dataMode"
            android:persistent="true"
            android:summary="@string/prefSummary_mobileDataSaver"
            android:title="@string/prefTitle_mobileDataSaver" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="prefCat_networkOptions"
        android:title="@string/prefCat_networkingOptions">
        <SwitchPreference
            android:key="pref_useWallhavenProxy"
            android:persistent="true"
            android:summary="@string/prefSummary_useWallhavenProxy"
            android:title="@string/prefTitle_useWallhavenProxy" />
        <EditTextPreference
            android:defaultValue="w.wallhaven.cc"
            android:dialogTitle="@string/prefDialog_wallhavenProxyHost"
            android:dependency="pref_useWallhavenProxy"
            android:inputType="textUri"
            android:key="pref_wallhavenProxyHost"
            android:persistent="true"
            android:singleLine="true"
            android:title="@string/prefTitle_wallhavenProxyHost"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="prefCat_debug"
        android:title="@string/prefCat_debug">
        <Preference
            android:key="pref_debugUrl"
            android:persistent="false"
            android:selectable="true"
            android:summary="@string/prefSummary_debugUrl"
            android:title="@string/prefTitle_debugUrl" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
