<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:key="prefCat_feedSettings"
        android:title="@string/prefCat_pullFeedSettings">
        <DropDownPreference
            android:defaultValue="@string/pref_updateMode_default"
            android:entries="@array/pref_updateMode_entries"
            android:entryValues="@array/pref_updateMode_entryValues"
            android:key="pref_updateMode"
            android:persistent="true"
            android:title="@string/pref_updateMode"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:dialogTitle="@string/prefDialog_tagFilter"
            android:inputType="text"
            android:key="pref_tagFilter"
            android:persistent="true"
            android:title="@string/prefTitle_tagFilter"
            app:useSimpleSummaryProvider="true" />
        <MultiSelectListPreference
            android:defaultValue="@array/pref_rankingFilterDefault_entryvalues"
            android:entries="@array/pref_rankingFilterLevel_entries"
            android:entryValues="@array/pref_rankingFilterLevel_entryvalues"
            android:key="pref_rankingFilterSelect"
            android:persistent="true"
            android:title="@string/prefTitle_rankingFilterSelect" />
        <MultiSelectListPreference
            android:defaultValue="@array/pref_rankingCategoryDefault_entryvalues"
            android:entries="@array/pref_rankingCategory_entries"
            android:entryValues="@array/pref_rankingCategory_entryvalues"
            android:key="pref_rankingCategorySelect"
            android:persistent="true"
            android:title="@string/prefTitle_rankingCategorySelect" />
        <Preference
            android:key="pref_forceRefresh"
            android:summary="@string/prefSummary_forceRefresh"
            android:title="@string/button_forceRefresh" />
        <Preference
            android:key="pref_clearCache"
            android:summary="@string/prefSummary_stuckApp"
            android:title="@string/button_clearCache" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="prefCat_apiKey"
        android:title="@string/prefCat_authSettings">
        <!--  The value itself lives in WallhavenMuzeiSupervisor, so this preference is not persistent  -->
        <EditTextPreference
            android:dialogTitle="@string/prefDialog_apiKey"
            android:inputType="textPassword"
            android:key="pref_api_key"
            android:persistent="false"
            android:title="@string/prefTitle_apiKey" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
